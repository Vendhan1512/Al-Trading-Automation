# Copy to .env and fill in. NEVER commit .env.
# Keys: owner = hardware wallet (Ledger via --ledger), agent & guardian = SEPARATE hot keys.
DEPLOYER_PK=
AGENT=            # agent address (not the key)
GUARDIAN=         # guardian address (not the key)
AGENT_PK=         # used by the agent service only
GUARDIAN_PK=      # used by the guardian service only — never share a host process with AGENT_PK
CONFIRM_MAINNET=  # set to "yes" only when deploying to chain 177
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
HSK_TESTNET_RPC=https://testnet.hsk.xyz
